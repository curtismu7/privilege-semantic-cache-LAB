# Optional. Everything has a safe default; the lab needs no tenant and no credentials.
# PORT must be in 7800-7999 (7847 is PROVISIONAL: claimed provisionally, not registered on the board yet).
PORT=7847
# PSC_BIND=127.0.0.1   # loopback only unless you set this on purpose (the Docker image sets it inside the container)
# LAB_ALLOWED_HOSTS=   # extra host names that reach this Mac (a lab-proxy name); loopback always works
# CUSTOMER_CONFIG=     # path to a customer.config.json (branding and vocabulary); Docker: see the volume comment in docker-compose.yml
